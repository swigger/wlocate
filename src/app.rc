#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDI_WLOCATE ICON "../assets/wlocate.ico"
1 RT_MANIFEST "app.manifest"
IDD_HOTKEY DIALOGEX 0, 0, 324, 207
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "快捷键设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
 LTEXT "设置从任意程序唤出 WLocate 的快捷键。", -1, 12, 12, 300, 16
 CONTROL "启用全局快捷键(&E)", IDC_HOTKEY_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 36, 200, 14
 GROUPBOX "唤出主窗口", -1, 12, 59, 300, 76
 CONTROL "Ctrl(&C)", IDC_HOTKEY_CTRL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 24, 78, 65, 14
 CONTROL "Alt(&A)", IDC_HOTKEY_ALT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 94, 78, 60, 14
 CONTROL "Shift(&S)", IDC_HOTKEY_SHIFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 160, 78, 65, 14
 CONTROL "Win(&W)", IDC_HOTKEY_WIN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 230, 78, 64, 14
 LTEXT "按键(&K)：", -1, 24, 108, 44, 12
 COMBOBOX IDC_HOTKEY_KEY, 72, 104, 160, 180, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_HOTKEY_STATUS, 12, 144, 300, 28
 PUSHBUTTON "恢复默认(&R)", IDC_HOTKEY_DEFAULT, 12, 181, 85, 16
 DEFPUSHBUTTON "确定", IDOK, 204, 181, 50, 16
 PUSHBUTTON "取消", IDCANCEL, 262, 181, 50, 16
END
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "WLocate File Search"
   VALUE "FileVersion", "1.0.0"
   VALUE "ProductName", "WLocate"
   VALUE "ProductVersion", "1.0.0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
